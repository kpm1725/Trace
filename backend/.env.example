MONGO_URL=mongodb://localhost:27017
DB_NAME=trace_database
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth client IDs (Google Cloud Console) — used to validate id_token audience.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# RevenueCat — billing is native IAP (Apple/Google) mediated through RevenueCat.
# See README.md for why RevenueCat instead of raw react-native-iap/expo-iap.
#
# REVENUECAT_WEBHOOK_SECRET: set the same value in the RevenueCat dashboard
#   (Project Settings → Integrations → Webhooks → Authorization header), sent
#   back as "Authorization: Bearer <this value>" on every webhook POST.
# REVENUECAT_SECRET_API_KEY: RevenueCat "Secret API key" (v1), used server-side
#   only for the best-effort /api/billing/sync REST lookup — never ship this
#   to the app, only the public SDK key goes in the frontend.
# REVENUECAT_UNLIMITED_ENTITLEMENT_ID: the entitlement identifier configured
#   in the RevenueCat dashboard for the unlimited-monthly product (default
#   below assumes you named it "unlimited").
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_UNLIMITED_ENTITLEMENT_ID=unlimited
