MONGO_URL=mongodb://localhost:27017
DB_NAME=trace_database
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth. Every client id the app may present must be listed here,
# comma-separated — a token whose `aud` is missing from this list is rejected.
# Scribe hardcoded the equivalent list in server.py; here it is configuration so
# adding an iOS client id is a Railway variable change rather than a deploy.
GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com,yyyy.apps.googleusercontent.com

# RevenueCat webhook (Google Play / App Store IAP fulfillment).
# Optional; if set, the webhook requires this bearer token.
REVENUECAT_WEBHOOK_AUTH=your_secret_here

# RevenueCat SECRET API key (Project Settings -> API keys), used by
# POST /api/billing/restore to read a subscriber's real entitlements.
# Optional: without it, restore falls back to replaying this server's own
# stored webhook deliveries. Never expose this key to the app.
REVENUECAT_API_KEY=sk_...

# Shown on the public account-deletion page (GET /account-deletion). Without it
# the page points people at the developer email on the store listing instead, so
# it is never contactless — but set it.
SUPPORT_EMAIL=

# Canonical privacy policy URL, linked from the deletion page. Hosted statically
# rather than served from here: this service being down is exactly when someone
# might be looking for it. See docs/README.md.
PRIVACY_POLICY_URL=https://kpm1725.github.io/trace-privacy/
