# Backend API base URL, no trailing slash.
EXPO_PUBLIC_BACKEND_URL=https://your-api-host.com

# Google OAuth client IDs from Google Cloud Console.
# Every id used here must also appear in the backend's GOOGLE_CLIENT_IDS,
# or the server rejects the token with "Token audience mismatch".
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# RevenueCat PUBLIC SDK keys (Project Settings -> API keys), one per platform.
# These are the public keys and ship in the app; the secret key is backend-only.
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
