# Backend URL (no trailing slash)
EXPO_PUBLIC_BACKEND_URL=https://your-api-host.com

# Google OAuth Client IDs from Google Cloud Console
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# RevenueCat public SDK keys (RevenueCat dashboard → Project → API Keys).
# These are safe to ship in the app — they're publishable keys, not secrets.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
