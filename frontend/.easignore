# Mirrors .gitignore for EAS uploads. EAS prefers this file when packaging the
# project, and unlike .gitignore it is honored even when the CLI can't use git.
#
# Keeping android/ and ios/ out of the upload is what forces EAS to run a fresh
# `expo prebuild` remotely. A stale local android/ folder from an older SDK
# ships its own Gradle wrapper, which then collides with what the current SDK
# and its native dependencies (react-native-purchases, react-native-svg)
# expect. Regenerating the native project on the build server means the wrapper
# always matches the SDK. Do not commit android/ or ios/, and do not remove
# these two lines.

# Environment
.env
.env.*
*.env
!.env.example

# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts
.metro-cache/
.metro-health-check*

# Native build outputs — must regenerate remotely, never upload
android/
ios/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Secrets that only `eas submit` needs locally
*service-account*.json

# EAS local caches
.eas/

# TypeScript
*.tsbuildinfo

# macOS
.DS_Store
*.pem

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*
