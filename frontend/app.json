{
  "expo": {
    "name": "Trace",
    "slug": "trace",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["trace", "com.violetseedlabs.trace"],
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.violetseedlabs.trace",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Trace uses the camera to photograph your breadboard or schematic so it can be diagnosed.",
        "NSPhotoLibraryUsageDescription": "Trace reads photos you choose so a circuit can be diagnosed from them."
      }
    },
    "android": {
      "package": "com.violetseedlabs.trace",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1A1428"
      },
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "trace" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#1A1428"
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Trace reads photos you choose so a circuit can be diagnosed from them.",
          "cameraPermission": "Trace uses the camera to photograph your breadboard or schematic so it can be diagnosed."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
